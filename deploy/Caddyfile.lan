# CoilGate on your home network only, with a certificate from Caddy's own
# private certificate authority (trust its root on your devices, see README).
#
# Replace coilgate.lan with the name you'll type in the browser. It must
# resolve to the Pi (router DNS entry, or the hosts file on your PC).
# To use the Pi's IP address instead, write it here, e.g.  192.168.1.50 {
#
# Install:  sudo cp deploy/Caddyfile.lan /etc/caddy/Caddyfile && sudo systemctl reload caddy

coilgate.lan {
	tls internal
	encode zstd gzip

	header {
		-Server
	}

	reverse_proxy 127.0.0.1:8000
}
